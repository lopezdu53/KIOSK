<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_workcenter_view_form_ws" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.ws.monitor</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">

            <!-- Botón de estadísticas: eventos de presencia -->
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_ws_view_presence_events"
                        class="oe_stat_button" icon="fa-video-camera">
                    <field name="ws_presence_event_count" widget="statinfo"
                           string="Eventos"/>
                </button>
            </div>

            <!-- Configuración del puesto (kiosk + cámara/IA) -->
            <field name="oee_target" position="after">
                <field name="ws_static_threshold"/>
                <label for="ws_api_key"/>
                <div class="o_row">
                    <field name="ws_api_key" password="True"
                           placeholder="Genera una clave para la estación..."/>
                    <button type="object" name="action_ws_generate_api_key"
                            string="Generar" class="btn-link"
                            icon="fa-refresh"/>
                </div>
            </field>
        </field>
    </record>

</odoo>
